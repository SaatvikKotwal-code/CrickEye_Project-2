SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Backward-compatible alias supported by backend/services/supabaseAdmin.js
# SUPABASE_SERVICE_KEY=
PORT=8080

# Ball analytics calibration preset (front-on net camera)
# A = batter-end stump line anchor, B = further up the pitch centerline.
CALIB_AX_A_X=0.50
CALIB_AX_A_Y=0.88
CALIB_AX_B_X=0.50
CALIB_AX_B_Y=0.18
CALIB_SEGMENT_M=10.06
CALIB_BATTER_END=A
# Raw estimate scale (single-camera under-reads; tune vs radar)
BALL_SPEED_SCALE=1.30
# P75–P90; higher = slightly faster read on long tracks
BALL_SPEED_PERCENTILE=79
# Whole-track (secant) blend 0–0.85: lifts km/h when per-frame diffs underestimate
BALL_SPEED_SECANT_BLEND=0.42
# When ≥3 matched balls and session median km/h is below the trigger, scale all speeds
# so median → target (capped by max factor). Disables if median already plausible.
BALL_SPEED_SESSION_RESCALE=true
BALL_SPEED_SESSION_MEDIAN_TARGET_KMH=70
BALL_SPEED_SESSION_RESCALE_IF_MEDIAN_BELOW_KMH=60
BALL_SPEED_SESSION_RESCALE_MAX_FACTOR=1.62
BALL_SPEED_SESSION_RESCALE_MIN_FACTOR=1.0
# Weight on 2D path speed vs axis-only (front-on nets often need high 2D weight)
BALL_SPEED_2D_WEIGHT=0.92
# Drop walking-speed artefacts; set 0 to never discard
BALL_SPEED_DISCARD_BELOW_KMH=24
# Noisy tracks pulled toward this floor (km/h)
BALL_SPEED_PLAUSIBLE_FLOOR_KMH=52
BALL_SPEED_FLOOR_BLEND=0.88
# Clean-looking tracks still below this (km/h) get a gentle lift toward club net pace
BALL_SPEED_CLUB_SOFT_FLOOR_KMH=46
BALL_SPEED_SOFT_FLOOR_BLEND=0.55
# Only apply club soft lift when raw estimate is already above this (avoids saving junk tracks)
BALL_SPEED_SOFT_FLOOR_MIN_RAW_KMH=30
# Set false to use raw _speed_profile output only
BALL_SPEED_REALISM=true
BALL_SPEED_CAP_KMH=160

# After per-shot bat speed is computed: cap lone spikes that exceed session median +
# swing-intensity expectation (reduces rare ~140+ km/h glitches on front-on pose).
# Set false to show raw peak_swing_speed from the pipeline.
SESSION_BAT_SPEED_LOCK=true

# LLM coaching insights (Gemini)
LLM_INSIGHTS_ENABLED=false
LLM_PROVIDER=dgx
LLM_TIMEOUT_MS=30000
LLM_MAX_OUTPUT_TOKENS=600
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
DGX_API_KEY=
DGX_LLM_URL=https://ai-services.mietjmu.in/gateway/llm/chat
DGX_LLM_MODEL=qwen3:latest

# Ball YOLO: predict = per-frame detect (default; matches standalone model.predict scripts).
# track = ByteTrack (BALL_YOLO_MODE=track).
# BALL_YOLO_MODE=predict
# BALL_PREDICT_CONF=0.50
# BALL_PREDICT_IOU=0.45
# BALL_PREDICT_IMGSZ=640
# Rolling trail length in Pass 2 MP4 (0 = full history). Default 72 ≈ 2.4s @ 30fps.
# BALL_VIDEO_TRAIL_SPAN_FRAMES=72
# Per-shot ball window around each peak (midpoints between peaks ± pre/post); widen if sparse.
# BALL_SHOT_BALL_PRE_FRAMES=52
# BALL_SHOT_BALL_POST_FRAMES=24
# BALL_SHOT_MIN_WINDOW_FRAMES=28
# Min merged detections to accept a shot window before falling back to greedy segment match.
# BALL_MIN_SHOT_BALL_FRAMES=2
